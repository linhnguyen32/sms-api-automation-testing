              "\r",
              "// Lấy status code\r",
              "const status = pm.response.code;\r",
              "const res = pm.response.json();\r",
              "\r",
              "// ===== CASE 1: Login thành công =====\r",
              "if (status === 200) {\r",
              "\r",
              "  pm.test(\"Login success\", () => {\r",
              "    pm.expect(res.message).to.eql(\"Login success\");\r",
              "  });\r",
              "\r",
              "  pm.test(\"Token is returned\", () => {\r",
              "    pm.expect(res.data).to.have.property(\"token\");\r",
              "  });\r",
              "\r",
              "  // Lưu token để dùng cho API sau\r",
              "  pm.environment.set(\"token\", res.data.token);\r",
              "\r",
              "}\r",
              "\r",
              "// ===== CASE 2: Sai thông tin đăng nhập =====\r",
              "else if (status === 401) {\r",
              "\r",
              "  pm.test(\"Unauthorized login\", () => {\r",
              "    pm.expect(res.message).to.include(\"Invalid\");\r",
              "  });\r",
              "\r",
              "  // Dừng workflow\r",
              "  postman.setNextRequest(null);\r",
              "}\r",
              "\r",
              "// ===== CASE 3: Không đủ quyền / bị khóa =====\r",
              "else if (status === 403) {\r",
              "\r",
              "  pm.test(\"Forbidden login\", () => {\r",
              "    pm.expect(res.message).to.include(\"forbidden\");\r",
              "  });\r",
              "\r",
              "  // Dừng workflow\r",
              "  postman.setNextRequest(null);\r",
              "}\r",
              ""
