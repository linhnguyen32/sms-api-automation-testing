    {
      "name": "TC02 Login Fail - Block Account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Wrapper response có cấu trúc và kiểu dữ liệu hợp lệ\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    // Core fields của wrapper\r",
              "    const coreFields = {\r",
              "        code: \"number\",\r",
              "        message: \"string\",\r",
              "        data: \"object\" // null cũng được coi là object trong JS\r",
              "    };\r",
              "\r",
              "    // Response phải là object\r",
              "    pm.expect(body).to.be.an(\"object\");\r",
              "\r",
              "    // Kiểm tra core fields\r",
              "    Object.keys(coreFields).forEach(function (field) {\r",
              "        pm.expect(body).to.have.property(field);\r",
              "\r",
              "        if (field === \"data\") {\r",
              "            pm.expect(body.data === null || typeof body.data === \"object\").to.be.true;\r",
              "        } else {\r",
              "            pm.expect(body[field]).to.be.a(coreFields[field]);\r",
              "        }\r",
              "    });\r",
              "});\r",
              ""
            ],
