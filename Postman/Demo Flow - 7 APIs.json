      "name": "TC01 Login Fail - WrongPass",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Error response có cấu trúc và kiểu dữ liệu hợp lệ\", function () {\r",
              "    const body = pm.response.json();\r",
              "\r",
              "    // Danh sách core fields cho error response\r",
              "    const coreFields = {\r",
              "        errorCode: \"string\",\r",
              "        error: \"string\",\r",
              "        message: \"string\",\r",
              "        timestamp: \"string\",\r",
              "        path: \"string\"\r",
              "    };\r",
              "\r",
              "    // Response phải là object\r",
              "    pm.expect(body).to.be.an(\"object\");\r",
              "\r",
              "    // Kiểm tra tồn tại và kiểu dữ liệu của core fields\r",
              "    Object.keys(coreFields).forEach(function (field) {\r",
              "        pm.expect(body).to.have.property(field);\r",
              "        pm.expect(body[field]).to.be.a(coreFields[field]);\r",
              "    });\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
