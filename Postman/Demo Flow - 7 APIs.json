              "\r",
              "/* ========= Kiểm tra wrapper ========= */\r",
              "pm.test(\"Response có code là number\", function () {\r",
              "    pm.expect(res).to.have.property(\"code\");\r",
              "    pm.expect(res.code).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response có message là string\", function () {\r",
              "    pm.expect(res).to.have.property(\"message\");\r",
